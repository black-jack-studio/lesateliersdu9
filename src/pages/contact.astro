---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/nav";
---

<Layout
  title="Contact"
  description="Contactez Les Ateliers du 9 · Stéphanie Ollivier et Vincent Machet, Sainte-Catherine-de-Fierbois."
  active="/contact/"
  cta={{ label: "Appeler Stéphanie", href: `tel:${SITE.steph.tel}`, secondaryLabel: "Appeler Vincent", secondaryHref: `tel:${SITE.vincent.tel}` }}
>
  <section class="bg-fir px-5 py-16 text-center md:px-8 md:py-20">
    <p class="font-display text-sm uppercase tracking-tight text-paper/60">07 · Nous écrire</p>
    <h1 class="mt-2 text-5xl text-paper sm:text-6xl">Contact</h1>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-10 md:grid-cols-2">
      <div class="border-t border-taupe pt-6">
        <h2 class="text-2xl text-fir">Stéphanie Ollivier</h2>
        <p class="mt-1 text-sm text-ink/60">Ateliers culinaires Guy Demarle et démonstration Kobold</p>
        <div class="mt-5 flex flex-col gap-2 text-base">
          <a href={`tel:${SITE.steph.tel}`} class="font-display text-xl text-fir">{SITE.steph.phone}</a>
        </div>
      </div>
      <div class="border-t border-taupe pt-6">
        <h2 class="text-2xl text-fir">Vincent Machet</h2>
        <p class="mt-1 text-sm text-ink/60">Coaching bien-être</p>
        <div class="mt-5 flex flex-col gap-2 text-base">
          <a href={`tel:${SITE.vincent.tel}`} class="font-display text-xl text-fir">{SITE.vincent.phone}</a>
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-taupe pt-8">
      <h2 class="text-2xl text-fir">Les Ateliers du 9</h2>
      <a href={`mailto:${SITE.email}`} class="mt-4 inline-block break-all text-base text-ink/70 underline decoration-taupe underline-offset-4">{SITE.email}</a>
    </div>

    <div class="mt-16 border-t border-taupe pt-8">
      <h2 class="text-2xl text-fir">Nous trouver</h2>
      <p class="mt-3 text-lg text-ink/80">{SITE.town}</p>
    </div>

    <div class="mt-16 border-t border-taupe pt-8">
      <h2 class="text-2xl text-fir">Suivez-nous</h2>
      <div class="mt-4 flex gap-6 text-base">
        <a href={SITE.facebook} class="text-ink/70 underline decoration-taupe underline-offset-4">Facebook</a>
        <a href={SITE.instagram} class="text-ink/70 underline decoration-taupe underline-offset-4">Instagram</a>
      </div>
    </div>
  </section>
</Layout>
