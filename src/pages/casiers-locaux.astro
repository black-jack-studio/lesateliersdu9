---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/nav";
import { Image } from "astro:assets";
import casiers from "../assets/photos/casiers.jpg";

const online = [
  { n: "01", title: "Achetez en ligne", text: "Choisissez votre produit et réglez en quelques clics." },
  { n: "02", title: "Recevez votre code", text: "Un code à usage unique vous est envoyé par SMS ou email." },
  { n: "03", title: "Débloquez votre casier", text: "Entrez le code, récupérez votre produit." },
];
---

<Layout
  title="Casiers locaux"
  description="Casiers de producteurs locaux aux Ateliers du 9 : achetez en ligne ou directement sur place."
  active="/casiers-locaux/"
  cta={{ label: "Nous écrire", href: `mailto:${SITE.email}` }}
>
  <section class="bg-fir px-5 py-16 text-center md:px-8 md:py-20">
    <p class="font-display text-sm uppercase tracking-tight text-paper/60">06 · Nouveau</p>
    <h1 class="mt-2 text-5xl text-paper sm:text-6xl">Casiers locaux</h1>
    <p class="mx-auto mt-6 max-w-sm text-balance text-base leading-relaxed text-paper/80">
      Achetez en ligne ou directement sur place, et repartez avec des produits de producteurs locaux.
    </p>
  </section>

  <Image src={casiers} alt="Les casiers de producteurs locaux" class="aspect-[3/2] w-full object-cover md:aspect-[21/9]" widths={[600, 1000, 1500]} sizes="100vw" loading="eager" />

  <div class="mx-auto max-w-xl px-5 pt-6 md:px-8">
    <p class="border border-taupe bg-paper-dim px-4 py-3 text-center text-xs leading-relaxed text-ink/60">
      Dispositif en cours de lancement.
    </p>
  </div>

  <section class="mx-auto max-w-xl px-5 py-12 md:px-8">
    <h2 class="text-2xl text-fir">Comment ça marche</h2>

    <h3 class="mt-8 font-display text-xl text-fir">Sur place</h3>
    <p class="mt-2 border-t border-taupe pt-4 text-sm leading-relaxed text-ink/70">
      Sur place, dans les casiers, repartez directement avec vos produits.
    </p>

    <h3 class="mt-10 font-display text-xl text-fir">Ou en ligne</h3>
    <ol class="mt-2 flex flex-col gap-5">
      {online.map((s) => (
        <li class="flex gap-4 border-t border-taupe pt-5">
          <span class="font-display text-2xl text-fir/40">{s.n}</span>
          <div>
            <h4 class="text-lg font-bold text-fir">{s.title}</h4>
            <p class="mt-1 text-sm leading-relaxed text-ink/70">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-paper-dim px-5 py-14 text-center md:px-8 md:py-20">
    <h2 class="text-2xl text-fir sm:text-3xl">Vous êtes producteur·rice local·e ?</h2>
    <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink/70">
      Les casiers des Ateliers du 9 cherchent de nouveaux produits locaux à proposer au voisinage.
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="mt-6 inline-block rounded-full bg-fir px-6 py-3 font-display text-sm uppercase tracking-tight text-paper"
    >
      Nous écrire
    </a>
    <p class="mt-3 text-xs text-ink/50">{SITE.email}</p>
  </section>
</Layout>
