---
interface Props {
  label: string;
  href: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { label, href, secondaryLabel, secondaryHref } = Astro.props;
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-taupe bg-paper/95 px-4 py-3 backdrop-blur md:hidden">
  <div class="flex gap-2">
    {secondaryLabel && secondaryHref && (
      <a
        href={secondaryHref}
        class="flex-1 rounded-full border-2 border-fir px-4 py-3 text-center font-display text-sm uppercase tracking-tight text-fir"
      >
        {secondaryLabel}
      </a>
    )}
    <a
      href={href}
      class="flex-1 rounded-full bg-fir px-4 py-3 text-center font-display text-sm uppercase tracking-tight text-paper"
    >
      {label}
    </a>
  </div>
</div>
<div class="h-20 md:hidden" aria-hidden="true"></div>
